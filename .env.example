# ============================================================
# ENVIRONMENT CONFIGURATION — ADDISU CAREER MANAGEMENT PLATFORM
# ============================================================
# Copy this file to .env.local for local development.
# Set these values in Vercel / Netlify / Cloudflare for production.

# ---
# SUPABASE (required for production — skip to use mock localStorage mode)
# ---
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ---
# AI Assistant (Gemini API — keep SERVER-SIDE ONLY — never commit real keys)
# ---
# VITE_GEMINI_API_KEY is intentionally NOT set here.
# The Gemini API key must be set as a BACKEND server environment variable only.
# Use Vercel's /api/chat.js serverless function or Supabase Edge Functions.
GEMINI_API_KEY=your_gemini_api_key_here

# ---
# Google Analytics (optional)
# ---
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
